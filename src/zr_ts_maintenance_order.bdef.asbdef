managed with additional save implementation in class zbp_r_ts_maintenance_order unique;
strict ( 2 );
with draft;

define behavior for ZR_TS_MAINTENANCE_ORDER alias MaintenanceOrder
persistent table zts_maint_order
draft table zts_d_maint_ord
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  create;
  update ( features : instance );
  delete ( features : instance );

  association _Operations { create; with draft; }
  association _Costs { create; with draft; }
  association _Attachments { create; with draft; }

  field ( numbering : managed, readonly ) OrderUuid;
  field ( readonly ) OrderId, OrderStatus, TechObjType, LocalLastChangedAt, LastChangedAt, TotalPlannedCosts, TotalActualCosts,
                     TotalPlannedHours, TotalActualHours, MaintOrdActualStartDateTime, MaintOrdActualFinishDateTime,
                     MaintOrdDelayHours, MaintOrdPlndFinalDueDateTime;
  field ( features : instance ) OrderType, MaintRevision, TechObject, LongText, PlanningPlant, WorkCenter,
                                MaintOrdBasicStartDateTime, MaintOrdBasicFinishDateTime;

  determination setOrderId on save { create; }
  determination calculateCosts on modify { create; field Currency; }
  determination setTypeDefaults on modify { field OrderType; }
  determination setDueDate on modify { field Priority, MaintOrdBasicStartDateTime; }
  determination setTechObjType on modify { field TechObject; }
  determination createFirstOperation on modify { create; }
  determination scheduleOperations on modify { field MaintOrdBasicStartDateTime; }
  determination setInitialStatus on save { create; }

  action ( features : instance ) releaseOrder result [1] $self;
  action ( features : instance ) completeOrder result [1] $self;

  validation validateTypeRules on save { create; field OrderType, Priority, TechObject, LongText,
                                         MaintOrdBasicStartDateTime, MaintOrdBasicFinishDateTime,
                                         MaintOrdFinalDueDateTime, PlanningPlant, WorkCenter,
                                         MaintOrdActualFinishDateTime; }
  validation validateDueDate on save { create; field OrderType, MaintOrdBasicFinishDateTime, MaintOrdFinalDueDateTime,
                                       MaintOrdActualFinishDateTime; }

  determine action checkDueDate { validation validateDueDate; }

  side effects
  {
    field Currency affects field TotalPlannedCosts, field TotalActualCosts, entity _Costs;
    field OrderType affects field Priority, field MaintOrdBasicStartDateTime, field MaintOrdFinalDueDateTime,
                            field MaintRevision,
                            permissions ( field MaintRevision, field TechObject, field LongText,
                                          field MaintOrdBasicStartDateTime, field MaintOrdBasicFinishDateTime );
    field Priority affects field MaintOrdFinalDueDateTime;
    determine action checkDueDate executed on field MaintOrdFinalDueDateTime, field Priority, field OrderType,
                                              field MaintOrdBasicStartDateTime, entity _Operations
                                  affects messages;
    field MaintOrdBasicStartDateTime affects field MaintOrdFinalDueDateTime, field MaintOrdBasicFinishDateTime,
                                         entity _Operations;
    field TechObject affects field TechObjType;
    entity _Operations affects field TotalPlannedCosts, field TotalActualCosts, field TotalPlannedHours,
                               field TotalActualHours, field MaintOrdBasicFinishDateTime,
                               field MaintOrdActualStartDateTime, field MaintOrdActualFinishDateTime,
                               field MaintOrdDelayHours, entity _Operations, entity _Costs;
    action releaseOrder affects entity _Status, entity _Operations;
    action completeOrder affects entity _Status, entity _Operations;
  }

  draft action Activate optimized;
  draft action Discard;
  draft action ( features : instance ) Edit;
  draft action Resume;
  draft determine action Prepare { validation validateTypeRules; validation validateDueDate; validation MaintenanceOperation~validateExecution;
                                   validation MaintenanceAttachment~validateMimeType;
                                   validation MaintenanceComponent~validateQuantity;
                                   validation MaintenancePrt~validateQuantity; }

  mapping for zts_maint_order
    {
      OrderUuid                   = order_uuid;
      OrderId                     = order_id;
      OrderType                   = order_type;
      OrderStatus                 = order_status;
      Description                 = description;
      LongText                    = long_text;
      TechObject                  = tech_object;
      TechObjType                 = tech_obj_type;
      PlanningPlant               = planning_plant;
      WorkCenter                  = work_center;
      Priority                    = priority;
      MaintOrdFinalDueDateTime    = final_due_datetime;
      MaintOrdPlndFinalDueDateTime = planned_final_due;
      MaintRevision               = maint_revision;
      MaintOrdBasicStartDateTime  = basic_start_datetime;
      MaintOrdBasicFinishDateTime = basic_finish_datetime;
      MaintOrdActualStartDateTime  = actual_start_datetime;
      MaintOrdActualFinishDateTime = actual_finish_datetime;
      MaintOrdDelayHours          = delay_hours;
      Currency                    = currency;
      TotalPlannedCosts           = total_planned_costs;
      TotalActualCosts            = total_actual_costs;
      TotalPlannedHours           = total_planned_hours;
      TotalActualHours            = total_actual_hours;
      LocalLastChangedAt          = local_last_changed_at;
      LastChangedAt               = last_changed_at;
    }
}

define behavior for ZR_TS_MAINTENANCE_OPERATION alias MaintenanceOperation
persistent table zts_maint_operat
draft table zts_d_maint_opr
lock dependent by _MaintenanceOrder
authorization dependent by _MaintenanceOrder
{
  update;
  delete ( features : instance, precheck );

  association _MaintenanceOrder { with draft; }
  association _Components { create ( features : instance ); with draft; }
  association _PRTs { create ( features : instance ); with draft; }

  field ( numbering : managed, readonly ) OperationUuid;
  field ( readonly ) OrderUuid, OperationId, PlannedStart, PlannedFinish, ActualFinish, Confirmed, OperationStatus,
                     WaitingFor;
  field ( features : instance ) Stage, Description, PersonResp, ActualWork, ActualWorkUnit, ActualWorkDuration, ActualDurationUnit,
                                ActualStart, PlannedWork, PlannedWorkUnit, PlannedWorkDuration,
                                PlannedDurationUnit;

  action ( features : instance, authorization : update ) confirmOperation result [1] $self;

  determination setOperationId on modify { create; }
  determination createComponentAndPrt on modify { create; }
  determination addEmptyOperation on modify { field Description, PersonResp, PlannedWork, PlannedWorkDuration; }
  determination scheduleOperations on modify { create; delete; field Stage, Confirmed, Description, PersonResp,
                                               PlannedWork, PlannedWorkUnit, PlannedWorkDuration, PlannedDurationUnit,
                                               ActualWork, ActualWorkDuration, ActualStart, ActualFinish; }
  determination setActualFinish on modify { field ActualStart, ActualWork, ActualWorkUnit, ActualWorkDuration,
                                            ActualDurationUnit; }
  determination deleteIfEmpty on save { create; update; }
  determination calculateCosts on modify { create; delete; field Confirmed, Description, PersonResp, PlannedWork, PlannedWorkUnit,
                                           PlannedWorkDuration, PlannedDurationUnit, ActualWork, ActualWorkUnit,
                                           ActualWorkDuration, ActualDurationUnit; }

  validation validateExecution on save { create; field Stage, Confirmed, ActualStart, ActualFinish, Description,
                                         PlannedWork, PlannedWorkUnit, PlannedWorkDuration, PlannedDurationUnit,
                                         ActualWork, ActualWorkUnit, ActualWorkDuration, ActualDurationUnit; }

  side effects
  {
    field Description affects field ActualStart, field ActualFinish, entity _MaintenanceOrder;
    field PersonResp affects field ActualStart, field ActualFinish, entity _MaintenanceOrder;
    field PlannedWork affects field PlannedStart, field PlannedFinish, entity _MaintenanceOrder,
                              entity _MaintenanceOrder._Operations;
    field PlannedWorkUnit affects field PlannedStart, field PlannedFinish, entity _MaintenanceOrder,
                                  entity _MaintenanceOrder._Operations;
    field PlannedWorkDuration affects field PlannedStart, field PlannedFinish, entity _MaintenanceOrder,
                                      entity _MaintenanceOrder._Operations;
    field PlannedDurationUnit affects field PlannedStart, field PlannedFinish, entity _MaintenanceOrder,
                                      entity _MaintenanceOrder._Operations;
    field ActualStart affects field ActualFinish, entity _MaintenanceOrder;
    field ActualWork affects field ActualStart, field ActualFinish, entity _MaintenanceOrder;
    field ActualWorkUnit affects field ActualStart, field ActualFinish, entity _MaintenanceOrder;
    field ActualWorkDuration affects field ActualStart, field ActualFinish, entity _MaintenanceOrder;
    field ActualDurationUnit affects field ActualStart, field ActualFinish, entity _MaintenanceOrder;
    field Stage affects field ActualStart, field ActualFinish, entity _MaintenanceOrder, entity _MaintenanceOrder._Operations;
    action confirmOperation affects entity _MaintenanceOrder, entity _MaintenanceOrder._Operations, entity _Components, entity _PRTs,
                                    entity _MaintenanceOrder._Costs;
    entity _Components affects entity _MaintenanceOrder, entity _Components, entity _MaintenanceOrder._Costs;
    entity _PRTs affects entity _MaintenanceOrder, entity _PRTs, entity _MaintenanceOrder._Costs;
  }

  mapping for zts_maint_operat
    {
      OperationUuid       = operation_uuid;
      OrderUuid           = order_uuid;
      OperationId         = operation_id;
      Description         = description;
      PersonResp          = person_resp;
      PlannedWorkUnit     = planned_work_work_unit;
      PlannedDurationUnit = planned_work_work_duration_uni;
      ActualWorkUnit      = actual_work_unit;
      ActualDurationUnit  = actual_work_duration_unit;
      PlannedWork         = planned_work;
      PlannedWorkDuration = planned_work_duration;
      ActualWork          = actual_work;
      ActualWorkDuration  = actual_work_duration;
      PlannedStart        = planned_start;
      PlannedFinish       = planned_finish;
      ActualStart         = actual_start;
      ActualFinish        = actual_finish;
      Stage               = stage;
      Confirmed           = confirmed;
      OperationStatus     = oper_status;
      WaitingFor          = waiting_for;
    }
}

define behavior for ZR_TS_MAINTENANCE_COSTS alias MaintenanceCosts
persistent table zts_maint_costs
draft table zts_d_maint_cst
lock dependent by _MaintenanceOrder
authorization dependent by _MaintenanceOrder
{
  update;
  delete;

  association _MaintenanceOrder { with draft; }

  field ( numbering : managed, readonly ) CostItemUuid;
  field ( readonly ) OrderUuid, OperationUuid, OperationId, OperationDescription, Currency, PlannedCosts, ActualCosts,
                     LaborPlannedCosts, LaborActualCosts, MaterialPlannedCosts, MaterialActualCosts,
                     PrtPlannedCosts, PrtActualCosts;

  mapping for zts_maint_costs
    {
      CostItemUuid         = cost_item_uuid;
      OrderUuid            = order_uuid;
      OperationUuid        = operation_uuid;
      OperationId          = operation_id;
      OperationDescription = operation_desc;
      Currency             = currency;
      PlannedCosts         = planned_costs;
      ActualCosts          = actual_costs;
      LaborPlannedCosts    = labor_planned_costs;
      LaborActualCosts     = labor_actual_costs;
      MaterialPlannedCosts = material_planned_costs;
      MaterialActualCosts  = material_actual_costs;
      PrtPlannedCosts      = prt_planned_costs;
      PrtActualCosts       = prt_actual_costs;
    }
}

define behavior for ZR_TS_MAINTENANCE_COMPONENT alias MaintenanceComponent
persistent table zts_maint_compon
draft table zts_d_maint_cmp
lock dependent by _MaintenanceOrder
authorization dependent by _MaintenanceOrder
{
  update;
  delete ( features : instance, precheck );

  association _MaintenanceOperation { with draft; }
  association _MaintenanceOrder { with draft; }

  field ( numbering : managed, readonly ) ComponentUuid;
  field ( readonly ) OperationUuid, OrderUuid, ItemNo;
  field ( features : instance ) Description, Uom, ComponentId, ReqQuantity, StorageLoc;

  determination setOrderUuid on modify { create; }
  determination setComponentData on modify { field ComponentId; }
  determination calculateCosts on modify { create; delete; field ComponentId, ReqQuantity, Uom; }
  determination addEmptyComponent on modify { field ComponentId, Description, ReqQuantity; }
  determination deleteIfEmpty on save { create; update; }
  validation validateQuantity on save { create; update; }

  side effects
  {
    field ComponentId affects field Description, field Uom,
                              permissions ( field Description, field Uom, field StorageLoc ),
                              entity _MaintenanceOrder, entity _MaintenanceOrder._Costs;
    field Description affects permissions ( field ComponentId, field StorageLoc );
    field ReqQuantity affects entity _MaintenanceOrder, entity _MaintenanceOrder._Costs;
  }

  mapping for zts_maint_compon
    {
      ComponentUuid = component_uuid;
      OperationUuid = operation_uuid;
      ComponentId   = component_id;
      Description   = description;
      Uom           = uom;
      ReqQuantity   = req_quantity;
      StorageLoc    = storage_loc;
      ItemNo        = item_no;
    }
}

define behavior for ZR_TS_MAINTENANCE_PRT alias MaintenancePrt
persistent table zts_maint_prt
draft table zts_d_maint_prt
lock dependent by _MaintenanceOrder
authorization dependent by _MaintenanceOrder
{
  update;
  delete ( features : instance, precheck );

  association _MaintenanceOperation { with draft; }
  association _MaintenanceOrder { with draft; }

  field ( numbering : managed, readonly ) PrtUuid;
  field ( readonly ) OperationUuid, OrderUuid, ItemNo;
  field ( features : instance ) Description, Uom, ActualUsage, ActualUsageUnit, PrtId, ReqQuantity, StorageLoc,
                                PlannedUsage, PlannedUsageUnit;

  determination setOrderUuid on modify { create; }
  determination setPrtData on modify { field PrtId; }
  determination addEmptyPrt on modify { field PrtId, Description, ReqQuantity, PlannedUsage, ActualUsage; }
  determination deleteIfEmpty on save { create; update; }
  validation validateQuantity on save { create; update; }
  determination calculateCosts on modify { create; delete; field PrtId, ReqQuantity, PlannedUsage, PlannedUsageUnit,
                                           ActualUsage, ActualUsageUnit; }

  side effects
  {
    field PrtId affects field Description, field Uom,
                        permissions ( field Description, field Uom, field StorageLoc ),
                        entity _MaintenanceOrder, entity _MaintenanceOrder._Costs;
    field Description affects permissions ( field PrtId, field StorageLoc );
    field ReqQuantity affects entity _MaintenanceOrder, entity _MaintenanceOrder._Costs;
    field PlannedUsage affects entity _MaintenanceOrder, entity _MaintenanceOrder._Costs;
    field PlannedUsageUnit affects entity _MaintenanceOrder, entity _MaintenanceOrder._Costs;
    field ActualUsage affects entity _MaintenanceOrder, entity _MaintenanceOrder._Costs;
    field ActualUsageUnit affects entity _MaintenanceOrder, entity _MaintenanceOrder._Costs;
  }

  mapping for zts_maint_prt
    {
      PrtUuid          = prt_uuid;
      OperationUuid    = operation_uuid;
      PrtId            = prt_id;
      Description      = description;
      Uom              = uom;
      ReqQuantity      = req_quantity;
      StorageLoc       = storage_loc;
      ItemNo           = item_no;
      PlannedUsage     = planned_usage;
      PlannedUsageUnit = planned_usage_unit;
      ActualUsage      = actual_usage;
      ActualUsageUnit  = actual_usage_unit;
    }
}

define behavior for ZR_TS_MAINTENANCE_ATTACH alias MaintenanceAttachment
persistent table zts_maint_attach
draft table zts_d_maint_att
lock dependent by _MaintenanceOrder
authorization dependent by _MaintenanceOrder
{
  update;
  delete;

  association _MaintenanceOrder { with draft; }

  field ( numbering : managed, readonly ) AttachmentUuid;
  field ( readonly ) OrderUuid, CreatedBy, CreatedAt, LocalLastChangedAt;

  determination setMimeType on modify { field FileName, MimeType; }
  validation validateMimeType on save { create; field FileName, MimeType; }

  side effects
  {
    field Attachment affects field MimeType;
  }

  mapping for zts_maint_attach
    {
      AttachmentUuid     = attach_uuid;
      OrderUuid          = order_uuid;
      FileName           = file_name;
      MimeType           = mime_type;
      Attachment         = attachment;
      Description        = description;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}