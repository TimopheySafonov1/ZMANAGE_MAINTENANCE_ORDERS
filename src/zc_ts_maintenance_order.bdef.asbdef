projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_TS_MAINTENANCE_ORDER alias MaintenanceOrder
use etag
{
  use create;
  use update;
  use delete;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;

  use action releaseOrder;
  use action completeOrder;

  use association _Operations { create; with draft; }
  use association _Costs { with draft; }
}

define behavior for ZC_TS_MAINTENANCE_OPERATION alias MaintenanceOperation
{
  use update;
  use delete;

  use association _MaintenanceOrder { with draft; }
  use association _Components { create; with draft; }
  use association _PRTs { create; with draft; }
}

define behavior for ZC_TS_MAINTENANCE_COSTS alias MaintenanceCosts
{
  use association _MaintenanceOrder { with draft; }
}

define behavior for ZC_TS_MAINTENANCE_COMPONENT alias MaintenanceComponent
{
  use update;
  use delete;

  use association _MaintenanceOperation { with draft; }
  use association _MaintenanceOrder { with draft; }
}

define behavior for ZC_TS_MAINTENANCE_PRT alias MaintenancePrt
{
  use update;
  use delete;

  use association _MaintenanceOperation { with draft; }
  use association _MaintenanceOrder { with draft; }
}