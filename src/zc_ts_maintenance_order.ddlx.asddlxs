@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: {
    typeName:       'Zlecenie konserwacji',
    typeNamePlural: 'Zlecenia konserwacji',
    title:          { type: #STANDARD, value: 'OrderId' },
    description:    { type: #STANDARD, value: 'Description' }
  },
  presentationVariant: [{ sortOrder: [{ by: 'OrderId', direction: #DESC }] }]
}
annotate entity ZC_TS_MAINTENANCE_ORDER with
{
  @UI.facet: [
    { id: 'GeneralInfo',  purpose: #STANDARD, type: #COLLECTION,            label: 'Informacje ogólne', position: 10 },
    { id: 'BasicData',    parentId: 'GeneralInfo', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'BasicData',  label: 'Dane podstawowe', position: 10 },
    { id: 'Scheduling',   parentId: 'GeneralInfo', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Scheduling', label: 'Terminy',         position: 20 },
    { id: 'Costs',        parentId: 'GeneralInfo', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Costs',      label: 'Koszty',          position: 30 },
    { id: 'Operations',   purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      targetElement: '_Operations',  label: 'Operacje',        position: 20 },
    { id: 'CostItems',    purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      targetElement: '_Costs',       label: 'Pozycje kosztowe', position: 30 }
  ]

  @UI.hidden: true
  OrderUuid;

  @EndUserText.label: 'Numer zlecenia'
  @UI: { lineItem:       [{ position: 10, importance: #HIGH }],
         identification: [{ position: 10 }],
         fieldGroup:     [{ qualifier: 'BasicData', position: 10 }],
         selectionField: [{ position: 10 }] }
  OrderId;

  @EndUserText.label: 'Rodzaj zlecenia'
  @UI: { lineItem:       [{ position: 20, importance: #MEDIUM }],
         fieldGroup:     [{ qualifier: 'BasicData', position: 20 }],
         selectionField: [{ position: 20 }] }
  OrderType;

  @EndUserText.label: 'Opis'
  @UI: { lineItem:   [{ position: 30, importance: #HIGH }],
         fieldGroup: [{ qualifier: 'BasicData', position: 30 }] }
  Description;

  @EndUserText.label: 'Tekst długi'
  @UI.fieldGroup: [{ qualifier: 'BasicData', position: 40 }]
  @UI.multiLineText: true
  LongText;

  @EndUserText.label: 'Obiekt techniczny'
  @UI: { lineItem:       [{ position: 40, importance: #MEDIUM }],
         fieldGroup:     [{ qualifier: 'BasicData', position: 50 }],
         selectionField: [{ position: 30 }] }
  TechObject;

  @EndUserText.label: 'Typ obiektu technicznego'
  @UI.fieldGroup: [{ qualifier: 'BasicData', position: 60 }]
  TechObjType;

  @EndUserText.label: 'Zakład planowania'
  @UI: { lineItem:       [{ position: 50, importance: #LOW }],
         fieldGroup:     [{ qualifier: 'BasicData', position: 70 }],
         selectionField: [{ position: 40 }] }
  PlanningPlant;

  @EndUserText.label: 'Stanowisko robocze'
  @UI: { lineItem:   [{ position: 60, importance: #LOW }],
         fieldGroup: [{ qualifier: 'BasicData', position: 80 }] }
  WorkCenter;

  @EndUserText.label: 'Priorytet'
  @UI: { lineItem:       [{ position: 70, importance: #HIGH }],
         fieldGroup:     [{ qualifier: 'BasicData', position: 90 }],
         selectionField: [{ position: 50 }] }
  Priority;

  @EndUserText.label: 'Status'
  @UI: { lineItem:       [{ position: 80, importance: #HIGH }],
         fieldGroup:     [{ qualifier: 'BasicData', position: 100 }],
         selectionField: [{ position: 60 }] }
  Status;

  @EndUserText.label: 'Rewizja'
  @UI.fieldGroup: [{ qualifier: 'BasicData', position: 110 }]
  MaintRevision;

  @EndUserText.label: 'Podstawowa data rozpoczęcia'
  @UI: { lineItem:   [{ position: 90, importance: #MEDIUM }],
         fieldGroup: [{ qualifier: 'Scheduling', position: 10 }] }
  MaintOrdBasicStartDateTime;

  @EndUserText.label: 'Podstawowa data zakończenia'
  @UI: { lineItem:   [{ position: 100, importance: #MEDIUM }],
         fieldGroup: [{ qualifier: 'Scheduling', position: 20 }] }
  MaintOrdBasicFinishDateTime;

  @EndUserText.label: 'Termin ostateczny'
  @UI: { lineItem:   [{ position: 110, importance: #LOW }],
         fieldGroup: [{ qualifier: 'Scheduling', position: 30 }] }
  FinalDueDate;

  @EndUserText.label: 'Waluta'
  @UI.hidden: true
  Currency;

  @EndUserText.label: 'Koszty planowane łącznie'
  @UI: { lineItem:   [{ position: 120, importance: #MEDIUM }],
         fieldGroup: [{ qualifier: 'Costs', position: 10 }] }
  TotalPlannedCosts;

  @EndUserText.label: 'Koszty rzeczywiste łącznie'
  @UI: { lineItem:   [{ position: 130, importance: #MEDIUM }],
         fieldGroup: [{ qualifier: 'Costs', position: 20 }] }
  TotalActualCosts;

  @UI.hidden: true
  LocalLastChangedAt;

  @UI.hidden: true
  LastChangedAt;
}