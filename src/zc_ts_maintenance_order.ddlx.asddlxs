@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: {
    typeName:       'Zlecenie konserwacji',
    typeNamePlural: 'Zlecenia konserwacji',
    title:          { type: #STANDARD, value: 'Description' },
    description:    { type: #STANDARD, value: 'OrderId' }
  },
  presentationVariant: [{ sortOrder: [{ by: 'OrderId', direction: #DESC }] }]
}
annotate entity ZC_TS_MAINTENANCE_ORDER with
{
  @UI.facet: [
    { id: 'HeaderGeneral',   purpose: #HEADER, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'HeaderGeneral',   label: 'Ogólne',              position: 10 },
    { id: 'HeaderReference', purpose: #HEADER, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'ReferenceObject', label: 'Obiekt referencyjny', position: 20 },

    { id: 'OrderScope',       purpose: #STANDARD, type: #COLLECTION,
      label: 'Zakres zlecenia', position: 10 },
    { id: 'OrderDetails',     parentId: 'OrderScope', purpose: #STANDARD, type: #COLLECTION,
      label: 'Szczegóły zlecenia', position: 10 },
    { id: 'OrderInformation', parentId: 'OrderDetails', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'OrderInformation', label: 'Informacje o zleceniu', position: 10 },
    { id: 'ReferenceObject',  parentId: 'OrderDetails', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'ReferenceObject',  label: 'Obiekt referencyjny',   position: 20 },
    { id: 'Responsibilities', parentId: 'OrderDetails', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Responsibilities', label: 'Odpowiedzialności',     position: 30 },
    { id: 'DetailedDescription', parentId: 'OrderScope', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'DetailedDescription', label: 'Szczegółowy opis', position: 20 },

    { id: 'DatesAndCosts', purpose: #STANDARD, type: #COLLECTION,
      label: 'Terminy i koszty', position: 30 },
    { id: 'Scheduling',    parentId: 'DatesAndCosts', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Scheduling', label: 'Terminy', position: 10 },
    { id: 'Costs',         parentId: 'DatesAndCosts', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Costs',      label: 'Koszty',  position: 20 },

    { id: 'Operations',   purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      targetElement: '_Operations',  label: 'Operacje',         position: 40 },
    { id: 'CostItems',    purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      targetElement: '_Costs',       label: 'Pozycje kosztowe', position: 50 },
    { id: 'Status',       purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      targetElement: '_Status',      label: 'Status',           position: 60 },
    { id: 'Attachments',  purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      targetElement: '_Attachments', label: 'Załączniki',       position: 70 }
  ]

  @UI.hidden: true
  OrderUuid;

  @EndUserText.label: 'Numer zlecenia'
  @UI: { lineItem:       [{ position: 10, importance: #HIGH }],
         selectionField: [{ position: 10 }] }
  OrderId;

  @EndUserText.label: 'Rodzaj zlecenia'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZC_TS_MAINT_ORDER_TYPE_VH', element: 'MaintenanceOrderType' },
                                       useForValidation: true }]
  @UI.textArrangement: #TEXT_FIRST
  @UI: { lineItem:       [{ position: 20, importance: #MEDIUM }],
         fieldGroup:     [{ qualifier: 'OrderInformation', position: 30 },
                          { qualifier: 'HeaderGeneral', position: 10 }],
         selectionField: [{ position: 20 }] }
  OrderType;

  @UI.hidden: true
  OrderTypeName;

  @EndUserText.label: 'Status'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZC_TS_ORDER_STATUS_VH', element: 'Status' } }]
  @UI: { lineItem:       [{ position: 15, importance: #HIGH,
                            criticality: 'OrderStatusCriticality', criticalityRepresentation: #WITHOUT_ICON },
                          { type: #FOR_ACTION, dataAction: 'releaseOrder',  label: 'Zwolnij' },
                          { type: #FOR_ACTION, dataAction: 'completeOrder', label: 'Zakończ' }],
         identification: [{ type: #FOR_ACTION, dataAction: 'releaseOrder',  label: 'Zwolnij', position: 10 },
                          { type: #FOR_ACTION, dataAction: 'completeOrder', label: 'Zakończ', position: 20 }],
         selectionField: [{ position: 15 }] }
  OrderStatus;

  @UI.hidden: true
  OrderStatusText;

  @UI.hidden: true
  OrderStatusCriticality;

  @EndUserText.label: 'Opis zlecenia'
  @UI: { lineItem:   [{ position: 30, importance: #HIGH }],
         fieldGroup: [{ qualifier: 'OrderInformation', position: 20 }] }
  Description;

  @EndUserText.label: 'Tekst długi'
  @UI.fieldGroup: [{ qualifier: 'DetailedDescription', position: 10 }]
  @UI.multiLineText: true
  LongText;

  @EndUserText.label: 'Obiekt techniczny'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZC_TS_TECH_OBJ_VH', element: 'TechObject' },
                                       label: 'Wyszukiwanie wg danych obiektu',
                                       useForValidation: true },
                                     { qualifier: 'Hierarchy',
                                       entity: { name: 'ZC_TS_TECH_OBJ_HIER_VH', element: 'TechObject' },
                                       presentationVariantQualifier: 'Hierarchy',
                                       label: 'Wyszukiwanie wg hierarchii' }]
  @UI: { lineItem:       [{ position: 40, importance: #MEDIUM }],
         fieldGroup:     [{ qualifier: 'ReferenceObject', position: 10 }],
         selectionField: [{ position: 30 }] }
  TechObject;

  @EndUserText.label: 'Typ obiektu technicznego'
  @UI.fieldGroup: [{ qualifier: 'ReferenceObject', position: 20 }]
  TechObjType;

  @EndUserText.label: 'Zakład planowania'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZC_TS_PLANT_VH', element: 'Plant' },
                                       useForValidation: true }]
  @UI: { lineItem:       [{ position: 50, importance: #LOW }],
         fieldGroup:     [{ qualifier: 'Responsibilities', position: 20 }],
         selectionField: [{ position: 40 }] }
  PlanningPlant;

  @EndUserText.label: 'Główne stanowisko robocze'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZC_TS_WORK_CENTER_VH', element: 'WorkCenter' },
                                       additionalBinding: [{ localElement: 'PlanningPlant',
                                                             element: 'Plant',
                                                             usage: #FILTER_AND_RESULT }],
                                       useForValidation: true }]
  @UI: { lineItem:   [{ position: 60, importance: #LOW }],
         fieldGroup: [{ qualifier: 'Responsibilities', position: 10 }] }
  WorkCenter;

  @EndUserText.label: 'Priorytet'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZC_TS_PRIORITY_VH', element: 'Priority' },
                                       useForValidation: true }]
  @UI: { lineItem:       [{ position: 70, importance: #HIGH }],
         fieldGroup:     [{ qualifier: 'Scheduling', position: 10 },
                          { qualifier: 'HeaderGeneral', position: 20 }],
         selectionField: [{ position: 50 }] }
  Priority;

  @EndUserText.label: 'Rewizja'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZC_TS_REVISION_VH', element: 'MaintenanceRevision' },
                                       additionalBinding: [{ localElement: 'PlanningPlant',
                                                             element: 'Plant',
                                                             usage: #FILTER_AND_RESULT }],
                                       useForValidation: true }]
  @UI.fieldGroup: [{ qualifier: 'Scheduling', position: 20 }]
  MaintRevision;

  @EndUserText.label: 'Podstawowa data rozpoczęcia'
  @UI: { lineItem:   [{ position: 90, importance: #MEDIUM }],
         fieldGroup: [{ qualifier: 'Scheduling', position: 30 }] }
  MaintOrdBasicStartDateTime;

  @EndUserText.label: 'Podstawowa data zakończenia'
  @UI: { lineItem:   [{ position: 100, importance: #MEDIUM }],
         fieldGroup: [{ qualifier: 'Scheduling', position: 40 }] }
  MaintOrdBasicFinishDateTime;

  @EndUserText.label: 'Termin ostateczny'
  @UI: { lineItem:   [{ position: 110, importance: #LOW }],
         fieldGroup: [{ qualifier: 'Scheduling', position: 50 },
                      { qualifier: 'HeaderGeneral', position: 30 }] }
  MaintOrdFinalDueDateTime;

  @EndUserText.label: 'Waluta'
  @UI.hidden: true
  Currency;

  @EndUserText.label: 'Koszty planowane łącznie'
  @UI: { lineItem:   [{ position: 120, importance: #MEDIUM }],
         fieldGroup: [{ qualifier: 'Costs', position: 10 }] }
  TotalPlannedCosts;

  @EndUserText.label: 'Koszty rzeczywiste łącznie'
  @UI: { lineItem:   [{ position: 130, importance: #MEDIUM }],
         fieldGroup: [{ qualifier: 'Costs', position: 20 }] }
  TotalActualCosts;

  @EndUserText.label: 'Praca planowana (h)'
  @UI.fieldGroup: [{ qualifier: 'Costs', position: 30 }]
  TotalPlannedHours;

  @EndUserText.label: 'Praca rzeczywista (h)'
  @UI.fieldGroup: [{ qualifier: 'Costs', position: 40 }]
  TotalActualHours;

  @UI.hidden: true
  LocalLastChangedAt;

  @UI.hidden: true
  LastChangedAt;
}