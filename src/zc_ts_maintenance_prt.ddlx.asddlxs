@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: {
    typeName:       'Pomoc produkcyjna',
    typeNamePlural: 'Pomoce produkcyjne',
    title:          { type: #STANDARD, value: 'PrtId' },
    description:    { type: #STANDARD, value: 'Description' }
  },
  presentationVariant: [{ sortOrder: [{ by: 'PrtId', direction: #ASC }] }]
}
annotate entity ZC_TS_MAINTENANCE_PRT with
{
  @UI.facet: [
    { id: 'PrtData', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'PrtData', label: 'Dane pomocy produkcyjnej', position: 10 }
  ]

  @UI.hidden: true
  PrtUuid;

  @UI.hidden: true
  OperationUuid;

  @UI.hidden: true
  OrderUuid;

  @EndUserText.label: 'Numer pomocy produkcyjnej'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZC_TS_PRT_VH', element: 'Prt' },
                                       useForValidation: true }]
  @UI: { lineItem:       [{ position: 10, importance: #HIGH, cssDefault.width: '10rem' }],
         identification: [{ position: 10 }],
         fieldGroup:     [{ qualifier: 'PrtData', position: 10 }] }
  PrtId;

  @EndUserText.label: 'Opis'
  @UI: { lineItem:   [{ position: 20, importance: #HIGH, cssDefault.width: '12rem' }],
         fieldGroup: [{ qualifier: 'PrtData', position: 20 }] }
  Description;

  @EndUserText.label: 'Ilość wymagana'
  @UI: { lineItem:   [{ position: 30, importance: #HIGH, cssDefault.width: '9rem' }],
         fieldGroup: [{ qualifier: 'PrtData', position: 30 }] }
  ReqQuantity;

  @EndUserText.label: 'Jednostka miary'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZC_TS_UOM_VH', element: 'Uom' } }]
  @UI.hidden: true
  Uom;

  @EndUserText.label: 'Skład'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZC_TS_STOR_LOC_VH', element: 'StorageLoc' },
                                       additionalBinding: [{ element: 'Component',
                                                             localConstant: '',
                                                             usage: #FILTER }] }]
  @UI: { lineItem:   [{ position: 40, importance: #HIGH, cssDefault.width: '8rem' }],
         fieldGroup: [{ qualifier: 'PrtData', position: 40 }] }
  StorageLoc;

  @EndUserText.label: 'Planowany czas użycia (puste = cała operacja)'
  @UI: { fieldGroup: [{ qualifier: 'PrtData', position: 50 }] }
  PlannedUsage;

  @EndUserText.label: 'Jednostka czasu (plan)'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZC_TS_TIME_UNIT_VH', element: 'TimeUnit' } }]
  @UI.hidden: true
  PlannedUsageUnit;

  @EndUserText.label: 'Rzeczywisty czas użycia'
  @UI: { fieldGroup: [{ qualifier: 'PrtData', position: 60 }] }
  ActualUsage;

  @EndUserText.label: 'Jednostka czasu (rzeczywista)'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZC_TS_TIME_UNIT_VH', element: 'TimeUnit' } }]
  @UI.hidden: true
  ActualUsageUnit;
}